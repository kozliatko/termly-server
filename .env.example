# error | warn | info | debug
TERMLY_LOG_LEVEL=info

# Ping interval in ms. The CLI force-reconnects after 13 s of silence, so this
# has to stay comfortably below that.
TERMLY_HEARTBEAT_MS=5000

# How long an unclaimed pairing code stays valid (ms). The CLI's UI promises 5
# minutes.
TERMLY_PAIRING_TTL_MS=300000

# How long a session survives with neither CLI nor phone connected (ms).
TERMLY_SESSION_TTL_MS=300000

# Extra origins allowed to open a WebSocket, comma-separated. The page this
# relay serves is always allowed, and the CLI sends no Origin at all, so this
# only matters when a web client is hosted somewhere else.
# TERMLY_ALLOWED_ORIGINS=https://app.example.com
